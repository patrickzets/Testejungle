# Database configuration
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering?sslmode=disable

# HTTP server address
HTTP_ADDR=:8000

# AWS SQS / LocalStack configuration
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Keycloak / OIDC configuration
OIDC_ISSUER_URL=http://localhost:8080/realms/wagering
# OIDC_JWKS_URL is optional, defaults to OIDC_ISSUER_URL + /protocol/openid-connect/certs
OIDC_JWKS_URL=
OIDC_AUDIENCE=wagering-api

# Local-only test credentials (do NOT use in production)
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-secret

PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-secret

WALLET_INTERNAL_CLIENT_ID=wallet-internal
WALLET_INTERNAL_CLIENT_SECRET=wallet-internal-secret
